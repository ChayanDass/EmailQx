PORT=4000
DATABASE_URL="database-url"

# ==========================================
# REDIS CONFIGURATION (Upstash / Local)
# ==========================================
# Upstash Redis REST Credentials:
UPSTASH_REDIS_REST_URL="https://trusted-racer-156419.upstash.io"
UPSTASH_REDIS_REST_TOKEN="token"

# Set USE_LOCAL_REDIS=true to force local/docker Redis (bypasses Upstash):
# USE_LOCAL_REDIS=true
# REDIS_HOST="127.0.0.1"
# REDIS_PORT=6379

# ==========================================
# WORKER & RATE LIMITING
# ==========================================
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=1000
MAX_EMAILS_PER_HOUR_PER_SENDER=50
MAX_EMAILS_PER_HOUR_GLOBAL=500
