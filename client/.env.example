# ── Google OAuth ──────────────────────────────────────────────
# Obtain from https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
VITE_GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo

# ── API ────────────────────────────────────────────────────────
# Backend base URL — change to your deployed backend in production
VITE_API_URL=http://localhost:4000

# ── Dev server ─────────────────────────────────────────────────
VITE_PORT=3000

# ── Demo login fallback ────────────────────────────────────────
VITE_DEMO_USER_NAME=Oliver Brown
VITE_DEMO_USER_EMAIL=demo@example.com
VITE_DEFAULT_AVATAR_URL=https://lh3.googleusercontent.com/a/default-user=s96-c

# ── Sender options (comma-separated, first is default) ─────────
VITE_SENDER_OPTIONS=sender1@yourdomain.com,sales@yourdomain.com,support@yourdomain.com
