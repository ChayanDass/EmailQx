# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build output ───────────────────────────────────────────────
dist/
build/
out/

# ── Environment files (contain secrets) ───────────────────────
.env
.env.local
.env.development
.env.production
# Keep .env.example — it's safe to commit
!.env.example

# ── Database ───────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
prisma/dev.db
prisma/dev.db-journal

# ── Logs ───────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / Editor ────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── TypeScript ─────────────────────────────────────────────────
*.tsbuildinfo

# ── Vite ───────────────────────────────────────────────────────
.vite/

# ── Prisma generated client (regenerated by prisma generate) ───
